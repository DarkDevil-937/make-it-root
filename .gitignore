*.img
*.bin
*.zip
preloader*
boot*.bak
lk*.bak
tee*.bak
recovery*.bak
gpt*.bak

# Logs and runtime junk
*.log
root-ok.txt
gl-run.log
run.log
autoroot.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
